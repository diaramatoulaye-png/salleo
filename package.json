{
  "name": "salleo",
  "version": "1.0.0",
  "description": "SALLEO - Plateforme de réservation de salles",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -e \"require('fs').readFile('./src/db/schema.sql','utf8',(e,sql)=>{if(e)throw e; require('./src/config/db').query(sql).then(()=>{console.log('Migration OK');process.exit(0)}).catch(err=>{console.error(err);process.exit(1)})})\"",
    "seed:salles": "PGPASSWORD=$npm_config_dbpass psql -h localhost -U postgres -d salleo -f src/db/seedSalles.sql",
    "seed:salles": "psql $DATABASE_URL -f src/db/seedSalles.sql 2>/dev/null || psql -h $DB_HOST -U $DB_USER -d $DB_NAME -f src/db/seedSalles.sql",
    "seed:admin": "node src/db/seedAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}